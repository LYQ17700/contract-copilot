# 复制为 .env 后按需修改（骨架自带极简 .env 解析，无需 dotenv）
PORT=5180
HOST=127.0.0.1
LOG_LEVEL=info

# 上传与存储（后端 A）
STORAGE_DIR=./var/uploads
MAX_UPLOAD_MB=12
ALLOWED_EXTENSIONS=pdf,docx,txt,md,png,jpg,jpeg,bmp,tif,tiff,webp

# 文本提取（后端 B）
# stub | tesseract | vision-llm  —— 先用 stub 保证链路可跑通
OCR_PROVIDER=stub
TESSDATA_PREFIX=
CONTRACT_COPILOT_NODE_MODULES=
# Tesseract worker/识别超时与自动纠偏（后端 B）
OCR_TESSERACT_WORKER_TIMEOUT_MS=60000
OCR_TESSERACT_TIMEOUT_MS=60000
OCR_TESSERACT_RETRIES=2
OCR_TESSERACT_AUTO_ROTATE=1
OCR_TESSERACT_PSM=6

# 视觉模型 OCR（后端 B，配置 Key 后 OCR_PROVIDER=vision-llm 可用）
VISION_LLM_KEY=
VISION_LLM_BASE_URL=https://api.openai.com/v1
VISION_LLM_MODEL=gpt-5-vision
VISION_LLM_TIMEOUT_MS=90000
VISION_LLM_RETRIES=2
VISION_MAX_BYTES=8388608

# 下游 Pod2
POD2_BASE_URL=http://127.0.0.1:5178
ANALYZE_MODE=mock          # mock | remote

# 异步任务表（后端 A）
JOB_TTL_MIN=30             # 任务记录保留时长
JOB_SWEEP_MIN=5            # 进程内清理周期

# 跨域（前端同学联调用），多个用逗号分隔
CORS_ORIGINS=http://127.0.0.1:5178
